# ---------------------------------------------------------------
# CYP Furniture API - environment
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------

# Server port
PORT=4000

# Public URL of this API (used to build absolute links, e.g. in WhatsApp order messages)
PUBLIC_URL=http://localhost:4000

# Allowed browser origins (comma separated). The Next.js site runs on 3000 (or 3001 if 3000 is busy) in development.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database
#  - SQLite (default, zero setup):   DATABASE_URL="file:./dev.db"
#  - PostgreSQL:                      DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cypfurniture?schema=public"
#    -> also change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Secret used to sign admin JWT tokens - change this in production!
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin account (created by `npm run db:seed` if it does not exist yet)
ADMIN_EMAIL=admin@cypfurniture.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=CYP Administrator
