# URL of the Node.js API as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the Node.js API as seen from the Next.js server (same machine in development)
API_URL=http://localhost:4000

# Public URL of this website (used for SEO / Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin panel url: the only site allowed to embed the 3D preview page (/embed/3d)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
